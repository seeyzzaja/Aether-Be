enum DmPrivacy {
  EVERYONE
  FRIENDS_ONLY
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  username        String    @unique
  passwordHash    String?
  emailVerifiedAt DateTime?

  emailNotificationEnabled Boolean @default(true)

  sessions             Session[]
  oauthAccounts        OAuthAccount[]
  authTokens           AuthToken[]
  ownedServers         Server[]           @relation("ServerOwner")
  serverMemberships    ServerMember[]
  messages             Message[]
  reactions            Reaction[]
  readStates           ChannelReadState[]
  notifications        Notification[]
  pollVotes            PollVote[]
  auditLogs            AuditLog[]
  dmParticipations     DmParticipant[]
  friendshipsAsUserOne Friendship[]       @relation("FriendshipUserOne")
  friendshipsAsUserTwo Friendship[]       @relation("FriendshipUserTwo")
  friendshipActions    Friendship[]       @relation("FriendshipActionUser")

  blockedUsers   BlockedUser[] @relation("BlockedUsersByBlocker")
  blockedByUsers BlockedUser[] @relation("BlockedUsersByBlocked")
  dmPrivacy      DmPrivacy     @default(EVERYONE)

  messageRequestsSent     MessageRequest[] @relation("MessageRequestSender")
  messageRequestsReceived MessageRequest[] @relation("MessageRequestReceiver")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}
