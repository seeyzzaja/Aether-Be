model Server {
  id      String  @id @default(uuid())
  ownerId String
  name    String
  iconUrl String?

  owner User @relation("ServerOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  roles Role[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}
