# App
NODE_ENV=development
HOST=localhost
PORT=5000
WS_PORT=8080
PRESENCE_GRACE_PERIOD_MS=5000
BASE_URL=http://localhost:5000

# Database and cache
DATABASE_URL=postgresql://postgres:password@postgres:5432/aether?schema=public
REDIS_URL=redis://redis:6379
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=aether

# Auth
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# LiveKit
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Seed data
SEED_USER_PASSWORD=Password123!
SEED_OWNER_1_EMAIL=owner1@aether.test
SEED_OWNER_1_USERNAME=aether_owner_1
SEED_OWNER_2_EMAIL=owner2@aether.test
SEED_OWNER_2_USERNAME=aether_owner_2
SEED_MEMBER_EMAIL=member@aether.test
SEED_MEMBER_USERNAME=aether_member
